# Copy to keystore.properties (gitignored) and fill in with your own upload key.
# Create the key first, from the repo root:
#
#   keytool -genkeypair -v -keystore rapidreader-upload.jks \
#     -alias rapidreader -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .jks file and these passwords backed up somewhere safe and OUT of
# the repo. Play App Signing means losing this key is recoverable, but only by
# asking Google to reset the upload key — losing it before the first upload is
# not.
#
# CI reads the same four values from the environment instead:
#   RELEASE_STORE_FILE  RELEASE_STORE_PASSWORD  RELEASE_KEY_ALIAS  RELEASE_KEY_PASSWORD
#
# storeFile is resolved relative to the repo root.
storeFile=rapidreader-upload.jks
storePassword=
keyAlias=rapidreader
keyPassword=
